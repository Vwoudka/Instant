# --- HTTP server ---
PORT=5000

# --- MQTT broker (HiveMQ public broker by default) ---
MQTT_URL=mqtt://broker.hivemq.com:1883
# Leave blank if the broker requires no authentication:
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT topics used by the device / ESP firmware
MQTT_TOPIC_VOLTAGE=energy/voltage
MQTT_TOPIC_CURRENT=energy/current
MQTT_TOPIC_POWER=energy/power
MQTT_TOPIC_PF=energy/pf
MQTT_TOPIC_RELAY_STATE=relay/state
MQTT_TOPIC_RELAY_COMMAND=relay/command
MQTT_TOPIC_FAULT=fault/status
# Safety thresholds — the device publishes its config on connect, and the
# Settings page republishes on save (this replaces ThingSpeak fields 1-4)
MQTT_TOPIC_VMAX=settings/vmax
MQTT_TOPIC_IMAX=settings/imax
MQTT_TOPIC_PMAX=settings/pmax

# Set to true to generate mock MQTT data (no broker needed)
DEMO_MODE=false
